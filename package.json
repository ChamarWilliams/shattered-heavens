  },
  "dependencies": {
    "@netlify/blobs": "^11.1.7",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.3",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
