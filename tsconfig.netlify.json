{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.netlify.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["netlify/functions/**/*.ts", "src/coop/**/*.ts", "src/domain/SeededRandom.ts", "src/domain/elites.ts", "src/domain/specialRooms.ts", "src/domain/runItems.ts", "src/dungeon/**/*.ts"]
}
